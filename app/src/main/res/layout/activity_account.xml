<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
	
	<ImageView
		android:layout_height="100dp"
		android:layout_width="100dp"
		android:layout_marginTop="50dp"
		android:id="@+id/icon"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		app:layout_constraintTop_toTopOf="parent" />
	
	<FrameLayout
		android:layout_height="100dp"
		android:layout_width="100dp"
		app:layout_constraintTop_toTopOf="@+id/icon"
		app:layout_constraintBottom_toBottomOf="@+id/icon"
		app:layout_constraintLeft_toLeftOf="@+id/icon"
		app:layout_constraintRight_toRightOf="@+id/icon">
		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_height="match_parent"
			android:layout_width="match_parent">
			<ImageView
				android:id="@+id/select"
				android:layout_height="40dp"
				android:layout_width="40dp"
				android:src="@android:drawable/ic_menu_camera"
				android:contentDescription="Change profile photo"
				android:padding="8dp"
				android:background="@drawable/circle_accent"
				app:tint="@color/white"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintRight_toRightOf="parent" />
		</androidx.constraintlayout.widget.ConstraintLayout>
	</FrameLayout>
	
	<TextView
		android:layout_height="wrap_content"
		android:layout_width="wrap_content"
		app:layout_constraintTop_toBottomOf="@+id/icon"
		app:layout_constraintLeft_toLeftOf="parent"
		android:textAlignment="center"
		android:gravity="center_horizontal"
		app:layout_constraintRight_toRightOf="parent"
		android:id="@+id/im_tip"
		android:hint="Your profile icon is visible to people you have connected with"
		android:textColorHint="@color/hint_text"
		android:textSize="13sp"
		android:paddingLeft="24dp"
		android:paddingRight="24dp"
		android:layout_marginTop="12dp"
		android:layout_marginBottom="40dp" />
		
	<TextView
		android:layout_height="wrap_content"
		android:layout_width="wrap_content"
		app:layout_constraintTop_toBottomOf="@+id/im_tip"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		android:textAlignment="center"
		android:gravity="center_horizontal"
		android:textSize="12sp"
		android:textStyle="bold"
		android:id="@+id/security_key_label"
		android:text="Your Security Key"
		android:textColor="@color/text_secondary"
		android:layout_marginBottom="4dp" />

	<TextView
		android:layout_height="wrap_content"
		android:layout_width="wrap_content"
		app:layout_constraintTop_toBottomOf="@+id/security_key_label"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		android:textAlignment="center"
		android:gravity="center_horizontal"
		android:fontFamily="monospace"
		android:textColor="@color/text_primary"
		android:textSize="13sp"
		android:paddingLeft="24dp"
		android:paddingRight="24dp"
		android:id="@+id/security_key_value"
		android:text=""
		android:layout_marginBottom="24dp" />
		
	<FrameLayout
		android:id="@+id/pref_con"
		android:layout_height="wrap_content"
		android:layout_width="match_parent"
		app:layout_constraintTop_toBottomOf="@+id/security_key_value"
		app:layout_constraintBottom_toBottomOf="parent" />
		

</androidx.constraintlayout.widget.ConstraintLayout>