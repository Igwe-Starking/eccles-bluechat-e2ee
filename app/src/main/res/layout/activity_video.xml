<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
	
	<FrameLayout
		android:id="@+id/caller_video_container"
		android:layout_height="match_parent"
		android:layout_width="match_parent">

		<!-- TextureView, not SurfaceView: a SurfaceView's actual pixel content is composited by
			 SurfaceFlinger on its own native layer, positioned by the window manager - View-level
			 transforms like rotation are NOT applied to that content (only plain translation
			 generally is), which is why rotating the SurfaceView/its wrapper had no visible
			 effect at all. TextureView is drawn inline as a normal GL texture within the regular
			 view hierarchy, so setRotation() (applied in code, in VideoActivity#addContent)
			 actually rotates what's displayed. Sized to the screen's swapped dimensions in code
			 too, for the same reason as before: the camera's frames are always landscape (see
			 VideoEncoder's WIDTH/HEIGHT comment), so the unrotated view needs swapped
			 width/height for its rotated footprint to exactly fill the portrait screen. -->
		<TextureView
			android:id="@+id/caller_video"
			android:layout_height="wrap_content"
			android:layout_width="wrap_content"
			android:layout_gravity="center" />

	</FrameLayout>
		
	<FrameLayout
		android:layout_height="match_parent"
		android:layout_width="match_parent">
		
		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_height="match_parent"
			android:layout_width="match_parent">
			
			<ImageView
				android:layout_height="25dp"
				android:layout_width="25dp"
				app:layout_constraintLeft_toLeftOf="@+id/duration"
				android:layout_margin="10dp"
				android:src="@drawable/ic_video_call"
				android:id="@+id/ic_top" />
				
			<Chronometer
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:id="@+id/duration"
				app:layout_constraintRight_toRightOf="parent"
				android:layout_margin="12dp"
				android:textColor="@color/on_brand"
				android:shadowColor="#99000000"
				android:shadowRadius="6"
				android:textSize="16sp"
				android:drawableLeft="@android:drawable/presence_online" />
			<ImageView
				android:layout_height="100dp"
				android:layout_width="100dp"
				android:layout_marginTop="200dp"
				android:id="@+id/icon"
				app:layout_constraintLeft_toLeftOf="parent"
				app:layout_constraintRight_toRightOf="parent"
				app:layout_constraintTop_toBottomOf="@+id/ic_top" />
				
			<TextView
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:textSize="22sp"
				android:textStyle="bold"
				android:textColor="@color/on_brand"
				android:shadowColor="#99000000"
				android:shadowRadius="6"
				android:maxLines="1"
				android:id="@+id/name"
				app:layout_constraintLeft_toLeftOf="parent"
				app:layout_constraintRight_toRightOf="parent"
				app:layout_constraintTop_toBottomOf="@+id/icon"
				android:layout_marginTop="20dp" />
				
			<!-- Both start hidden - VideoActivity shows them once the call is actually
				 accepted/ongoing (there's nothing to toggle speaker/camera on yet during
				 ringing), stacked in the top-right corner below the duration timer, out of the
				 way of both the full-screen remote video and the local preview/accept-reject
				 controls at the bottom. -->
			<com.google.android.material.floatingactionbutton.FloatingActionButton
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:id="@+id/speaker_bt"
				app:fabSize="mini"
				app:layout_constraintRight_toRightOf="parent"
				app:layout_constraintTop_toBottomOf="@+id/duration"
				android:layout_margin="10dp"
				android:src="@drawable/ic_speaker"
				app:tint="@color/white"
				android:contentDescription="Toggle speaker"
				android:visibility="gone" />

			<com.google.android.material.floatingactionbutton.FloatingActionButton
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:id="@+id/switch_camera_bt"
				app:fabSize="mini"
				app:layout_constraintRight_toRightOf="parent"
				app:layout_constraintTop_toBottomOf="@+id/speaker_bt"
				android:layout_margin="10dp"
				android:src="@drawable/ic_flip_camera"
				app:tint="@color/white"
				android:contentDescription="Switch camera"
				android:visibility="gone" />

			<com.google.android.material.floatingactionbutton.FloatingActionButton
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:id="@+id/reject_bt"
				app:backgroundTint="@color/danger"
				android:src="@drawable/ic_call"
				android:rotation="-90"
				app:layout_constraintLeft_toLeftOf="parent"
				app:layout_constraintBottom_toBottomOf="parent"
				android:layout_margin="15dp" />
				
			<com.google.android.material.floatingactionbutton.FloatingActionButton
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:id="@+id/accept_bt"
				app:backgroundTint="@color/call_accept"
				android:src="@drawable/ic_call"
				app:layout_constraintRight_toRightOf="parent"
				app:layout_constraintBottom_toBottomOf="parent"
				android:layout_margin="15dp"
				android:rotation="90" />
			
			
		</androidx.constraintlayout.widget.ConstraintLayout>
		
	</FrameLayout>
	
	<FrameLayout
		android:layout_height="match_parent"
		android:layout_width="match_parent">
		<!-- Plain FrameLayout, not the deprecated AbsoluteLayout: prev's free-form position is
			 set directly on the view itself (View#setX/setY in VideoActivity's
			 PreviewDragListener), which works inside any ViewGroup at all - AbsoluteLayout's
			 own x/y LayoutParams aren't actually needed for that and never were. -->
		<FrameLayout
			android:layout_height="match_parent"
			android:layout_width="match_parent"
			android:id="@+id/drag_parent">
			<SurfaceView
				android:id="@+id/prev"
				android:layout_height="200dp"
				android:layout_width="100dp" />
		</FrameLayout>
	</FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>